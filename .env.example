# ============================================================
# Environment Variables Configuration
# Copy this file to .env or edit directly for local dev.
# ============================================================

# ------------------------------------------------------------
# 1. APPLICATION SECRETS & KEYS GENERATION
# ------------------------------------------------------------
# How to generate 32+ character random secret keys:
# Python CLI : python -c "import secrets; print(secrets.token_hex(32))"
# OpenSSL CLI: openssl rand -hex 32
# PowerShell : -join ((48..57) + (65..90) + (97..122) | Get-Random -Count 64 | ForEach-Object {[char]$_})
# Documentation: https://docs.python.org/3/library/secrets.html

API_SECRET_KEY=9f8e7d6c5b4a3f2e1d0c9b8a7f6e5d4c3b2a1f0e9d8c7b6a5f4e3d2c1b0a9f8e
SECRET_KEY=9f8e7d6c5b4a3f2e1d0c9b8a7f6e5d4c3b2a1f0e9d8c7b6a5f4e3d2c1b0a9f8e
SUPERSET_SECRET_KEY=1a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9a0b1c2d3e4f5a6b7c8d9e0f1a2b
SUPERSET_ADMIN_PASSWORD=AdminSecurePassword2026!

# ------------------------------------------------------------
# 2. DATABASE PASSWORDS, ROLES & LOCAL URL
# ------------------------------------------------------------
# Documentation: https://www.postgresql.org/docs/current/sql-createuser.html
POSTGRES_PASSWORD=PostgresAdminPassword2026!
API_DB_PASSWORD=ApiDbUserPassword2026!
ML_DB_PASSWORD=MlDbUserPassword2026!
MLFLOW_DB_PASSWORD=MlflowDbUserPassword2026!
INGESTION_DB_PASSWORD=IngestionDbUserPassword2026!
DASHBOARD_DB_PASSWORD=DashboardDbUserPassword2026!
SUPERSET_DB_PASSWORD=SupersetDbUserPassword2026!

# Local direct DB connection URL (used when running python scripts directly outside Docker)
DATABASE_URL=postgresql://churn_admin:PostgresAdminPassword2026!@localhost:5432/churn_db

# ------------------------------------------------------------
# 3. SERVICE ENDPOINTS & LOCAL DASHBOARD LINKS
# ------------------------------------------------------------
# FastAPI Server   : http://localhost:8000
# OpenAPI / Docs   : http://localhost:8000/api/docs
# ReDoc UI         : http://localhost:8000/api/redoc
# Metrics Endpoint : http://localhost:8000/metrics
# MLflow UI        : http://localhost:5000
# Superset UI      : http://localhost:8088

MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=churn_prediction

# ------------------------------------------------------------
# 4. MODEL & RISK THRESHOLDS CONFIGURATION
# ------------------------------------------------------------
MODEL_NAME=churn_predictor
MODEL_VERSION=latest
RISK_BAND_LOW=0.30
RISK_BAND_MED=0.55
RISK_BAND_HIGH=0.75

# ------------------------------------------------------------
# 5. LOGGING & PRIVACY
# ------------------------------------------------------------
# LOG_LEVEL options: debug | info | warning | error
LOG_LEVEL=info
# Set LOG_CLIENT_IP=false to suppress client IP address logging completely (GDPR strict mode)
LOG_CLIENT_IP=true

# ------------------------------------------------------------
# 6. AWS & CLOUD DEPLOYMENT (PRODUCTION ONLY)
# ------------------------------------------------------------
# AWS KMS / Secrets Manager Guide: https://docs.aws.amazon.com/secretsmanager/latest/userguide/intro.html
# AWS IAM Policies Guide: https://docs.aws.amazon.com/IAM/latest/UserGuide/access_policies.html
# AWS_REGION=us-east-1
# AWS_ACCOUNT_ID=123456789012
# ECR_REGISTRY=${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com
