FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    git \
    && rm -rf /var/lib/apt/lists/*

COPY ml/requirements.training.txt .
RUN pip install --no-cache-dir -r requirements.training.txt

COPY ml/ ./ml/
COPY pipelines/ ./pipelines/

ENV PYTHONPATH=/app

CMD ["python", "-c", "print('Training worker ready. Run pipeline scripts via make or docker exec.')"]
